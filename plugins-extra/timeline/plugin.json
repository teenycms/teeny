{
    "id": "timeline",
    "name": "Timeline",
    "description": "Milestones or your story, from the first day to today.",
    "version": "1.0",
    "author": "Teeny CMS",
    "section": {
        "label": "Timeline",
        "desc": "Milestones or a history",
        "fields": {
            "title": {
                "type": "text",
                "label": "Title",
                "max": 80
            },
            "items": {
                "type": "list",
                "label": "Milestones",
                "max": 30,
                "item": {
                    "when": {
                        "type": "text",
                        "label": "When (e.g. 2019)",
                        "max": 30
                    },
                    "title": {
                        "type": "text",
                        "label": "Title",
                        "max": 100
                    },
                    "text": {
                        "type": "textarea",
                        "label": "Text",
                        "max": 300
                    }
                }
            }
        },
        "defaults": {
            "title": "Our story",
            "items": [
                {
                    "when": "2019",
                    "title": "A tiny kitchen",
                    "text": "We started baking for friends and neighbours."
                },
                {
                    "when": "2021",
                    "title": "Our first shop",
                    "text": "A small corner shop with one big oven."
                },
                {
                    "when": "Today",
                    "title": "Still baking every morning",
                    "text": "Same recipes, a few more ovens, and you."
                }
            ]
        }
    }
}
