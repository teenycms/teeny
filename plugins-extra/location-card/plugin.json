{
    "id": "location-card",
    "name": "Location card",
    "description": "Your address, opening times and an \"Open in Maps\" button. No embedded map, so no trackers.",
    "version": "1.0",
    "author": "Teeny CMS",
    "section": {
        "label": "Location card",
        "desc": "Address, hours and a map link",
        "fields": {
            "title": {
                "type": "text",
                "label": "Title",
                "max": 80
            },
            "address": {
                "type": "textarea",
                "label": "Address",
                "max": 300
            },
            "hours": {
                "type": "textarea",
                "label": "Opening times",
                "max": 300
            },
            "map": {
                "type": "url",
                "label": "Map link (Google Maps, Apple Maps or Waze)"
            },
            "button": {
                "type": "text",
                "label": "Button text",
                "max": 40
            }
        },
        "defaults": {
            "title": "Visit us",
            "address": "12 Jalan Bunga\nKuala Lumpur",
            "hours": "Mon to Fri 8:00 to 18:00\nSat 9:00 to 15:00",
            "map": "https://maps.google.com/?q=Kuala+Lumpur",
            "button": "Open in Maps"
        }
    }
}
