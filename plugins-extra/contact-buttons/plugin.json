{
    "id": "contact-buttons",
    "name": "Contact buttons",
    "description": "WhatsApp, call and email buttons in one tidy row, easy to tap on phones.",
    "version": "1.1",
    "author": "Teeny CMS",
    "section": {
        "label": "Contact buttons",
        "desc": "WhatsApp, call and email",
        "fields": {
            "title": {
                "type": "text",
                "label": "Title (optional)",
                "max": 80
            },
            "whatsapp": {
                "type": "url",
                "label": "WhatsApp link (e.g. https://wa.me/60123456789)"
            },
            "phone": {
                "type": "url",
                "label": "Phone link (e.g. tel:+60123456789)"
            },
            "email": {
                "type": "url",
                "label": "Email link (e.g. mailto:hello@example.com)"
            }
        },
        "defaults": {
            "title": "Talk to us",
            "whatsapp": "https://wa.me/60123456789",
            "phone": "tel:+60123456789",
            "email": "mailto:hello@example.com"
        }
    }
}
