{
    "id": "price-list",
    "name": "Menu or price list",
    "description": "Dishes, drinks or services with descriptions, prices and little tags like \"Vegan\" or \"New\".",
    "version": "1.1",
    "author": "Teeny CMS",
    "section": {
        "label": "Menu or price list",
        "desc": "Items with prices and tags",
        "fields": {
            "title": {
                "type": "text",
                "label": "Title",
                "max": 80
            },
            "items": {
                "type": "list",
                "label": "Items",
                "max": 60,
                "item": {
                    "name": {
                        "type": "text",
                        "label": "Name",
                        "max": 80
                    },
                    "desc": {
                        "type": "textarea",
                        "label": "Description",
                        "max": 200
                    },
                    "price": {
                        "type": "text",
                        "label": "Price",
                        "max": 20
                    },
                    "tag": {
                        "type": "text",
                        "label": "Tag (optional, e.g. Vegan)",
                        "max": 20
                    }
                }
            },
            "note": {
                "type": "textarea",
                "label": "Note",
                "max": 300
            }
        },
        "defaults": {
            "title": "Breakfast",
            "items": [
                {
                    "name": "Sourdough toast",
                    "desc": "Butter and homemade jam",
                    "price": "$6",
                    "tag": "Vegan option"
                },
                {
                    "name": "Croissant",
                    "desc": "Baked this morning",
                    "price": "$4",
                    "tag": ""
                },
                {
                    "name": "Seasonal fruit bowl",
                    "desc": "With yoghurt and honey",
                    "price": "$8",
                    "tag": "New"
                }
            ],
            "note": "Please tell us about any allergies."
        }
    }
}
