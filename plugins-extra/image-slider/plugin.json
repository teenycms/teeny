{
    "id": "image-slider",
    "name": "Image slider",
    "description": "Swipeable photos with arrows and dots. Interactive, and runs in a secure sandbox.",
    "version": "1.0",
    "author": "Teeny CMS",
    "section": {
        "label": "Image slider",
        "desc": "Swipeable photos",
        "fields": {
            "slides": {
                "type": "list",
                "label": "Slides",
                "max": 20,
                "item": {
                    "image": {
                        "type": "image",
                        "label": "Image"
                    },
                    "caption": {
                        "type": "text",
                        "label": "Caption",
                        "max": 120
                    }
                }
            }
        },
        "defaults": {
            "slides": [
                {
                    "image": "",
                    "caption": "First slide"
                },
                {
                    "image": "",
                    "caption": "Second slide"
                },
                {
                    "image": "",
                    "caption": "Third slide"
                }
            ]
        }
    },
    "widget": {
        "height": 420
    }
}
